{
  "name": "kotoba-hirameki-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ことばのひらめき（仮） - 1日3分の日本語ひらめきパズル（MVP）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vite-node scripts/validate-questions.ts",
    "questions:list": "vite-node scripts/export-question-list.ts",
    "themes:list": "vite-node scripts/export-theme-list.ts",
    "check": "npm run validate && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-node": "^2.1.4",
    "vitest": "^2.1.4"
  }
}
